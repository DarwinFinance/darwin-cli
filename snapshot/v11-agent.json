      "title": "Set or cancel TP/SL",
      "description": "Set or cancel fixed-size TP/SL. Arguments are the API's own fields (get_api_reference). Counts against today's transaction budget.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Perps market, e.g. SOL."
          },
          "takeProfit": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "description": "Take-profit trigger price in USD, e.g. 160."
          },
          "stopLoss": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "description": "Stop-loss trigger price in USD, e.g. 120."
          },
          "sizePercent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "How much of the position to protect, in percent (default 100). Darwin shows the exact size before it sends."
          },
          "cancel": {
            "type": "string",
            "enum": [
              "tp",
              "sl",
              "both"
            ],
            "description": "Cancel this position's take-profit (tp), stop-loss (sl) or both, instead of setting them."
          },
          "maxSlippageBps": {
            "type": "number",
            "description": "Optional: the worst fill a triggered TP/SL accepts, in basis points, at most your owner's max."
          },
          "clientOrderNonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "Leave empty: Darwin makes a fresh order ID for every order. If a result is uncertain, don't run the command again \u2014 check it with `darwin retry`."
          }
